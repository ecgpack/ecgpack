keywords:
  - explicitly correlated Gaussians
  - few-body systems
  - variational method
  - high accuracy quantum-mechanical calculations
  - atomic and molecular structure
  - non-Born-Oppenheimer calculations
  - quantum chemistry
  - Fortran
  - MPI

repository-code: "https://github.com/ecgpack/ecgpack"

