  - family-names: Nasiri
    given-names: Saeed
    orcid: "https://orcid.org/0000-0001-8501-9859"
  - family-names: Rzhevskii
    given-names: Pavel
    orcid: "https://orcid.org/0009-0005-5996-3981"
  - family-names: Shomenov
    given-names: Toreniyaz
    orcid: "https://orcid.org/0000-0003-1153-4238"
  - family-names: Tumakov
    given-names: Dmitry
    orcid: "https://orcid.org/0000-0003-0708-2427"
