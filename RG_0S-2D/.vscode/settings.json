{
  // ---- Modern Fortran + fortls language server ----
  "fortran.linter.compiler": "gfortran",
  "fortran.fortls.path": "fortls",
  "[fortran]": {
    "editor.defaultFormatter": "fortran-lang.linter-gfortran"
  },
  "files.associations": {
    "*.f90": "FortranFreeForm",
    "*.f": "FortranFixedForm"
  },
  // Keep fortls from indexing build artifacts.
  "search.exclude": {
    "**/release": true,
    "**/debug": true,
    "**/bin": true
  }
}